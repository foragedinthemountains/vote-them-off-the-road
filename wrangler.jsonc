{
  "name": "vote-them-off-the-road",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "votethemofftheroad.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "votethemofftheroad-prod",
      "database_id": "db352eed-b01b-41c1-9cd8-e839e7980740"
    }
  ],
  "ratelimits": [
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "votethemofftheroad-photos"
    }
  ]
}
